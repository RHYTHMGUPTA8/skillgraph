# Copy this file to .env.local and fill in your Appwrite project details.
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=skillgraph_db
VITE_APPWRITE_PROFILES_TABLE_ID=profiles
VITE_APPWRITE_SKILLS_TABLE_ID=skills
VITE_APPWRITE_EVIDENCE_TABLE_ID=evidence
VITE_APPWRITE_OPPORTUNITIES_TABLE_ID=opportunities
VITE_APPWRITE_OPPORTUNITY_SKILLS_TABLE_ID=opportunity_skills
VITE_APPWRITE_APPLICATIONS_TABLE_ID=applications
